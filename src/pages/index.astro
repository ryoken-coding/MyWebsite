---
// Root entry: send visitors to their remembered language, defaulting to pt-PT.
// With JavaScript disabled, the native-language links remain usable.
import { locales } from '../i18n/locales';
import { getDictionary } from '../i18n';
import { siteUrl } from '../data/site';
import '../styles/global.css';

const target = '/pt/';
const defaultCopy = getDictionary('pt');
---
<!doctype html>
<html lang="pt-PT" dir="ltr" data-locale="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{defaultCopy['site.name']}</title>
    <meta name="description" content={defaultCopy['meta.home.description']} />
    {siteUrl && <link rel="canonical" href={new URL(target, siteUrl).toString()} />}
    {siteUrl && <meta property="og:url" content={new URL(target, siteUrl).toString()} />}
    {siteUrl && locales.map((locale) => (
      <link rel="alternate" hreflang={locale.tag} href={new URL(`/${locale.code}/`, siteUrl).toString()} />
    ))}
    {siteUrl && <link rel="alternate" hreflang="x-default" href={new URL(target, siteUrl).toString()} />}
    {siteUrl && <link rel="sitemap" href="/sitemap.xml" />}
    <meta name="robots" content="noindex, follow" />
    <script is:inline>
      (function () {
        var fallback = 'pt';
        var supported = ['pt','pt-br','en','es','fr','zh-cn','zh-tw','ru','uk','it','de','pl','hi','ko','ja','ar','bg','nl','sv','el','ro'];
        var saved = null;
        try { saved = localStorage.getItem('locale'); } catch (e) {}
        var target = supported.indexOf(saved) > -1 ? saved : fallback;
        window.location.replace('/' + target + '/');
      })();
    </script>
    <noscript>
      <style>
        body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1.25rem; line-height: 1.6; }
        ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: .5rem; }
        a { color: #0f766e; }
      </style>
    </noscript>
  </head>
  <body>
    <noscript>
      <h1>{defaultCopy['site.name']}</h1>
      <p>{defaultCopy['a11y.language']}</p>
      <nav aria-label={defaultCopy['a11y.language']}>
        <ul>
          {locales.map((locale) => (
            <li><a href={`/${locale.code}/`} lang={locale.tag} hreflang={locale.tag} dir={locale.dir}>{locale.nativeName}</a></li>
          ))}
        </ul>
      </nav>
    </noscript>
  </body>
</html>

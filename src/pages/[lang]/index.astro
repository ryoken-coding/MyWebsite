---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import { getDictionary } from '../../i18n';
import { locales } from '../../i18n/locales';
import { projects } from '../../data/projects';
import { stack } from '../../data/stack';
import { contact, contactPlaceholders, cv } from '../../data/site';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale.code } }));
}

const { lang } = Astro.params;
const locale = lang ?? 'pt';
const dict = getDictionary(locale);
const t = (key: string) => (dict as Record<string, string>)[key] ?? key;

const directLinks = [
  {
    label: 'contact.email',
    value: contact.email,
    placeholder: contactPlaceholders.email,
    href: contact.email ? `mailto:${contact.email}` : '',
    icon: 'mail',
    external: false,
  },
  {
    label: 'contact.github',
    value: contact.github,
    placeholder: contactPlaceholders.github,
    href: contact.github,
    icon: 'github',
    external: true,
  },
  {
    label: 'contact.whatsapp',
    value: contact.whatsapp,
    placeholder: contactPlaceholders.whatsapp,
    href: contact.whatsapp,
    icon: 'whatsapp',
    external: true,
  },
];
---
<BaseLayout
  locale={locale}
  path=""
  title={`${t('meta.home.title')} · ${t('site.name')}`}
  description={t('meta.home.description')}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="hero-badge"><span class="dot" aria-hidden="true"></span>{t('hero.badge')}</p>
        <h1>{t('hero.title')}</h1>
        <p class="lead">{t('hero.lead')}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="#projects">{t('hero.cta.projects')}<span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="#contact">{t('hero.cta.contact')}</a>
        </div>
      </div>

      <aside class="hero-panel" aria-label={t('hero.panel.title')}>
        <div class="panel-bar" aria-hidden="true">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span>{t('hero.panel.title')}</span>
        </div>
        <dl class="panel-list">
          <div class="panel-row">
            <dt>{t('hero.panel.study')}</dt>
            <dd>{t('hero.panel.course')}</dd>
          </div>
          <div class="panel-row">
            <dt>{t('hero.panel.intern')}</dt>
            <dd>{t('hero.panel.internship')}</dd>
          </div>
          <div class="panel-row">
            <dt>{t('hero.panel.practice')}</dt>
            <dd>{t('hero.panel.practiceValue')}</dd>
          </div>
          <div class="panel-row">
            <dt>{t('hero.panel.availability')}</dt>
            <dd class="accent">{t('hero.panel.remote')}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" id="stack" aria-labelledby="stack-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t('eyebrow.stack')}</p>
        <h2 id="stack-title">{t('stack.title')}</h2>
        <p class="lead">{t('stack.lead')}</p>
      </div>
      <ul class="area-strip" aria-label={t('stack.areas')}>
        {['area.frontend', 'area.backend', 'area.databases', 'area.security', 'area.games'].map((key, index) => (
          <li class="area-item">
            <span class="area-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span>{t(key)}</span>
          </li>
        ))}
      </ul>
      <div class="stack-grid">
        {stack.map((group, index) => (
          <article class="stack-card">
            <h3>
              <span class="index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              {t(group.groupKey)}
            </h3>
            <ul class="chips">
              {group.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <p class="stack-note">
        <Icon name="info" size={15} />
        <span>{t('stack.note')}</span>
      </p>
    </div>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t('eyebrow.projects')}</p>
        <h2 id="projects-title">{t('projects.title')}</h2>
        <p class="lead">{t('projects.lead')}</p>
      </div>
      <div class="projects-grid">
        {projects.map((project, index) => (
          <ProjectCard project={project} index={index} locale={locale} t={t} />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="path" aria-labelledby="path-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t('eyebrow.path')}</p>
        <h2 id="path-title">{t('path.title')}</h2>
        <p class="lead">{t('path.lead')}</p>
      </div>
      <div class="path-list">
        <article class="path-item">
          <span class="num" aria-hidden="true">01</span>
          <h3>{t('path.edu.title')}</h3>
          <p>{t('path.edu.body')}</p>
        </article>
        <article class="path-item">
          <span class="num" aria-hidden="true">02</span>
          <h3>{t('path.intern.title')}</h3>
          <p>{t('path.intern.body')}</p>
        </article>
        <article class="path-item">
          <span class="num" aria-hidden="true">03</span>
          <h3>{t('path.practice.title')}</h3>
          <p>{t('path.practice.body')}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="cv" aria-labelledby="cv-title">
    <div class="container">
      <div class="cv-band">
        <div>
          <h2 id="cv-title">{t('cv.title')}</h2>
          <p>{t('cv.lead')}</p>
        </div>
        <div class="cv-actions">
          {cv.file ? (
            <a class="btn btn--primary" href={cv.file} download>
              <Icon name="download" size={16} />{t('cv.button')}
            </a>
          ) : (
            <>
              <span class="btn btn--ghost btn--disabled" aria-disabled="true">
                <Icon name="download" size={16} />{t('cv.button')}
              </span>
              <p class="cv-pending">{t('cv.pending')} {cv.placeholder}</p>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t('eyebrow.contact')}</p>
        <h2 id="contact-title">{t('contact.title')}</h2>
        <p class="lead">{t('contact.lead')}</p>
      </div>
      <div class="contact-grid">
        <div>
          <h3>{t('contact.direct')}</h3>
          <ul class="direct-list">
            {directLinks.map((item) => (
              <li class="direct-row">
                <span class="label">{t(item.label)}</span>
                {item.href ? (
                  <a
                    href={item.href}
                    {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {item.value}
                    {item.external && <span class="sr-only"> ({t('a11y.external')})</span>}
                  </a>
                ) : (
                  <span class="placeholder">{item.placeholder}</span>
                )}
              </li>
            ))}
          </ul>
          <p class="direct-note">{t('contact.directNote')}</p>
        </div>
        <ContactForm locale={locale} t={t} />
      </div>
    </div>
  </section>
</BaseLayout>

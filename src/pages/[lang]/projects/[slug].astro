---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import IsolatedText from '../../../components/IsolatedText.astro';
import { createTranslator, localePath } from '../../../i18n';
import { locales } from '../../../i18n/locales';
import { projects } from '../../../data/projects';
import { contact, formEndpoint } from '../../../data/site';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    projects.map((project) => ({ params: { lang: locale.code, slug: project.slug } }))
  );
}

const { lang, slug } = Astro.params;
if (!lang) throw new Error('Missing locale route parameter');
const locale = lang;
const project = projects.find((item) => item.slug === slug);
if (!project) throw new Error(`Unknown project route: ${slug}`);
const t = createTranslator(locale);
const base = project.titleKey.replace('.title', '');
const features = Array.from({ length: project.featureCount }, (_, index) =>
  t(`${base}.feature${index + 1}`)
);
const hasProjectLinks = Boolean(project.repo || project.demo);
const hasContact = Boolean(contact.email || contact.github || contact.whatsapp || formEndpoint);
const home = localePath(locale);
const title = `${t(project.titleKey)} · ${t('site.name')}`;
const description = t(`${base}.summary`);
---
<BaseLayout locale={locale} path={`projects/${project.slug}`} title={title} description={description} pageType="article">
  <header class="project-hero">
    <div class="container">
      <a class="breadcrumb" href={`${home}#projects`}>
        <span aria-hidden="true">←</span> {t('project.back')}
      </a>
      <h1><IsolatedText locale={locale} text={t(project.titleKey)} /></h1>
      <p class="lead"><IsolatedText locale={locale} text={description} /></p>
    </div>
  </header>

  <div class:list={['container', 'project-layout', { 'project-layout--single': !hasProjectLinks }]}>
    <div class="project-main">
      <section aria-labelledby="context-title">
        <h2 id="context-title">{t('project.context')}</h2>
        <p><IsolatedText locale={locale} text={t(`${base}.context`)} /></p>
      </section>

      {features.length > 0 && (
        <section aria-labelledby="features-title">
          <h2 id="features-title">{t('project.features')}</h2>
          <ul class="feature-list">
            {features.map((feature) => <li><IsolatedText locale={locale} text={feature} /></li>)}
          </ul>
        </section>
      )}

      {project.tech.length > 0 && (
        <section aria-labelledby="tech-title">
          <h2 id="tech-title">{t('project.tech')}</h2>
          <ul class="chips">
            {project.tech.map((tech) => <li class="chip"><bdi dir="ltr">{tech}</bdi></li>)}
          </ul>
        </section>
      )}

      {project.images.length > 0 && (
        <section aria-labelledby="media-title">
          <h2 id="media-title">{t('project.images')}</h2>
          <ul class="media-list">
            {project.images.map((src, index) => (
              <li>
                <img
                  src={src}
                  alt={`${t(project.titleKey)} — ${t('project.images')} ${index + 1}`}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="project-cta">
        {hasContact && (
          <a class="btn btn--primary" href={`${home}#contact`}>
            {t('hero.cta.contact')}<span class="arrow" aria-hidden="true">→</span>
          </a>
        )}
        <a class="btn btn--ghost" href={`${home}#projects`}>{t('nav.projects')}</a>
      </div>
    </div>

    {hasProjectLinks && (
      <aside class="project-side">
        <section class="side-card" aria-labelledby="side-links">
          <h2 id="side-links">{t('project.links')}</h2>
          <div class="side-rows">
            {project.repo && (
              <div class="side-row">
                <span class="label">{t('project.repo')}</span>
                <span class="value"><a href={project.repo} target="_blank" rel="noopener noreferrer">{t('project.repo')}</a></span>
              </div>
            )}
            {project.demo && (
              <div class="side-row">
                <span class="label">{t('project.demo')}</span>
                <span class="value"><a href={project.demo} target="_blank" rel="noopener noreferrer">{t('project.demo')}</a></span>
              </div>
            )}
          </div>
        </section>
      </aside>
    )}
  </div>
</BaseLayout>

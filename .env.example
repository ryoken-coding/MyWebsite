# Copy to .env (local) or set these in Vercel → Project → Settings → Environment Variables.
# No value here is a secret; they only affect links and integrations.

# Public address of the site (no trailing slash). Used for canonical URLs,
# hreflang, Open Graph and the sitemap. Update it after the first Vercel deploy.
PUBLIC_SITE_URL=https://mywebsite.vercel.app

# Formspree endpoint, e.g. https://formspree.io/f/xxxxxxxx
# Leave empty to keep the form in its "not configured" state.
PUBLIC_FORMSPREE_ENDPOINT=
